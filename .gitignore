# ── 运行时数据 ───────────────────────────────────────────────
# 用户文件仓、会话、上传分片、缩略图、回收站暂存、错误日志。
# 体积以 G 计，且属于用户私有数据，绝不应进版本库。
runtime/*
!runtime/.htaccess
!runtime/index.php

# ── 本地配置 ─────────────────────────────────────────────────
# 含数据库账号密码与计划任务密钥。仓库是公开的，提交它等于把凭据公开。
# 新环境请复制 app/config.example.php 为 app/config.php 再填自己的值。
app/config.php

# 宝塔给 .user.ini 加了 chattr +i，且内容是本机 PHP 配置
.user.ini

# ── 本机工具配置 ─────────────────────────────────────────────
.claude/settings.local.json

# Trae 是编辑器目录，只把其中的方案文档入库，其余（缓存/配置）不入
.trae/*
!.trae/documents/

# ── 杂项 ─────────────────────────────────────────────────────
*.log
.DS_Store
Thumbs.db
